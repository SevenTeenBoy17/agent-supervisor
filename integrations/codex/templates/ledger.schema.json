{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-supervisor.local/schemas/ledger-v3.json",
  "title": "Supervisor v3 ledger compatibility view",
  "$comment": "This schema validates the structural compatibility view only. Draft 2020-12 JSON Schema cannot express the relational universal constraint that every dynamically named required goal.acceptance_criteria item has a successful, current, correctly bound evidence item. supervisor_core.validation.validate_state is the authoritative completion gate and rejects each required criterion whose complete expected_evidence set is not satisfied by validated EvidenceRecord/v3 events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "tasks",
    "intent_coverage",
    "invocations",
    "evidence",
    "reviews",
    "waivers",
    "terminal_state"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "intent_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/intent"
      }
    },
    "invocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invocation"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      }
    },
    "terminal_state": {
      "enum": [
        "complete",
        "incomplete",
        "blocked",
        "user-waived"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal_state": {
            "const": "complete"
          }
        },
        "required": [
          "terminal_state"
        ]
      },
      "then": {
        "$comment": "The constraints below are necessary structural checks, not a claim of cross-array criterion/evidence coverage. Runtime validation remains mandatory before terminal_state complete.",
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "done",
                    "superseded",
                    "cancelled"
                  ]
                }
              }
            }
          },
          "evidence": {
            "minItems": 1
          },
          "reviews": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "description",
        "domain",
        "expected_evidence",
        "required"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "expected_evidence": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "version",
        "source_request_hash",
        "change_mode",
        "objective",
        "acceptance_criteria",
        "in_scope",
        "out_of_scope",
        "constraints",
        "non_goals",
        "assumptions",
        "risks"
      ],
      "properties": {
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "source_request_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "change_mode": {
          "enum": [
            "continue",
            "extend",
            "replace"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "in_scope": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "out_of_scope": {
          "$ref": "#/$defs/strings"
        },
        "constraints": {
          "$ref": "#/$defs/strings"
        },
        "non_goals": {
          "$ref": "#/$defs/strings"
        },
        "assumptions": {
          "$ref": "#/$defs/strings"
        },
        "risks": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "goal_id",
        "goal_version",
        "criterion_ids",
        "allowed_paths",
        "expected_evidence",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_version": {
          "type": "integer",
          "minimum": 1
        },
        "criterion_ids": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "allowed_paths": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "expected_evidence": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "status": {
          "enum": [
            "doing",
            "done",
            "superseded",
            "cancelled"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "done"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "text_sha256",
        "status",
        "reason",
        "capability_ids",
        "method",
        "phase"
      ],
      "properties": {
        "intent_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "enum": [
            "covered",
            "skipped",
            "deferred",
            "unavailable",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "capability_ids": {
          "$ref": "#/$defs/strings"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "capability",
        "stage",
        "actor",
        "timestamp"
      ],
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "attempt",
            "result"
          ]
        },
        "result": {
          "enum": [
            "success",
            "failed",
            "refused",
            "cancelled",
            "manual-specialized",
            null
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "result"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "enum": [
                  "success",
                  "failed",
                  "refused",
                  "cancelled",
                  "manual-specialized"
                ]
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "criterion_id",
        "gate_id",
        "command_category",
        "command_args_sha256",
        "cwd_sha256",
        "collected_at",
        "exit_code",
        "output_sha256",
        "artifact_hash",
        "base",
        "head",
        "diff_hash",
        "collector"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "command_category": {
          "type": "string",
          "minLength": 1
        },
        "command_args_sha256": {
          "$ref": "#/$defs/hash"
        },
        "cwd_sha256": {
          "$ref": "#/$defs/hash"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_sha256": {
          "$ref": "#/$defs/hash"
        },
        "artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "base": {
          "$ref": "#/$defs/hash"
        },
        "head": {
          "$ref": "#/$defs/hash"
        },
        "diff_hash": {
          "$ref": "#/$defs/hash"
        },
        "collector": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "reviewer",
        "responsibility_group",
        "implementer",
        "base",
        "head",
        "diff_hash",
        "rerun_evidence_ids",
        "verdict"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "responsibility_group": {
          "type": "string",
          "minLength": 1
        },
        "implementer": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "$ref": "#/$defs/hash"
        },
        "head": {
          "$ref": "#/$defs/hash"
        },
        "diff_hash": {
          "$ref": "#/$defs/hash"
        },
        "rerun_evidence_ids": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "verdict": {
          "enum": [
            "APPROVE",
            "REQUEST_CHANGES",
            "NEEDS_DISCUSSION"
          ]
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_id",
        "criterion_id",
        "authorized_by",
        "source_authorization_sha256",
        "reason",
        "authorized_at"
      ],
      "properties": {
        "waiver_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "authorized_by": {
          "const": "user"
        },
        "source_authorization_sha256": {
          "$ref": "#/$defs/hash"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
